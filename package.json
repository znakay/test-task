  "homepage": "https://znakay.github.io/test-task",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --config webpack.config.js --open",
    "start": "npm run dev",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.js --mode=production",
    "build:dev": "cross-env NODE_ENV=development webpack --config webpack.config.js --mode=development",
    "clean": "rimraf dist",
    "serve": "serve -s dist -l 3000",
    "preview": "npm run build && npm run serve",
    "watch": "cross-env NODE_ENV=development webpack --config webpack.config.js --mode=development --watch",
    "stats": "cross-env NODE_ENV=production webpack --config webpack.config.js --mode=production --json > webpack-stats.json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "browserslist": [
    "last 3 versions"
  ],
